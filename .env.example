# Copy this file to .env and fill in real values. Never commit .env.
ENVIRONMENT=development
POSTGRES_USER=crypto
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crypto_intelligence
DATABASE_URL=postgresql+psycopg://crypto:change-me@postgres:5432/crypto_intelligence
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
BINANCE_SPOT_BASE_URL=https://api.binance.com
# Where api.binance.com is restricted by location, use the public
# market-data endpoint instead: https://data-api.binance.vision
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_REQUEST_TIMEOUT_SECONDS=10
BINANCE_MAX_RETRIES=3
TRACKED_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT
# Phase 3 announcement monitor (undocumented Binance website CMS feed)
BINANCE_ANNOUNCEMENTS_BASE_URL=https://www.binance.com
BINANCE_ANNOUNCEMENTS_ENDPOINT=/bapi/composite/v1/public/cms/article/list/query
ANNOUNCEMENT_POLLING_INTERVAL_SECONDS=300
ANNOUNCEMENT_NOTIFICATION_CATEGORIES=
# Phase 4/5 intelligence processing
INTELLIGENCE_PROCESSING_INTERVAL_SECONDS=600
# Phase 6 competition volume tracker
VOLUME_TRACKING_INTERVAL_MINUTES=30
VOLUME_BACKFILL_MAX_INTERVALS_PER_PAIR=48
VOLUME_MAX_PAGES_PER_INTERVAL=50
VOLUME_NOTIFICATIONS_ENABLED=true
# Phase 7 market, futures, and news intelligence
MARKET_SNAPSHOT_INTERVAL_MINUTES=5
MARKET_MIN_QUOTE_VOLUME_USDT=1000000
MARKET_ALERT_COOLDOWN_MINUTES=60
MARKET_PRICE_ALERT_THRESHOLD_PERCENT=5.0
MARKET_VOLUME_SPIKE_MULTIPLIER=2.0
MARKET_FRESHNESS_MINUTES=10
FUTURES_FUNDING_INTERVAL_MINUTES=5
FUTURES_OPEN_INTEREST_INTERVAL_MINUTES=15
FUTURES_FUNDING_ALERT_THRESHOLD=0.001
NEWS_COLLECTION_INTERVAL_MINUTES=5
MARKET_NOTIFICATIONS_ENABLED=true

# Phase 8 administration and security (placeholders only)
# Bootstrap credentials are read by backend/scripts/create_admin.py
# from the environment; never commit real values.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_EMAIL=
SESSION_INACTIVITY_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
SESSION_COOKIE_NAME=admin_session
CSRF_COOKIE_NAME=admin_csrf
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=30
PASSWORD_RESET_TOKEN_MINUTES=60
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4
# Base64-encoded 32-byte AES-GCM key; required in production.
# Key ids are stable version labels: keep the previous id with the
# previous key during rotation so old rows still decrypt.
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=
CREDENTIAL_ENCRYPTION_KEY_ID=v1
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS_ID=
DASHBOARD_REFRESH_INTERVAL_SECONDS=60
