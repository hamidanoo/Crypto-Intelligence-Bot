# Copy this file to .env and fill in real values. Never commit .env.
ENVIRONMENT=development
POSTGRES_USER=crypto
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crypto_intelligence
DATABASE_URL=postgresql+psycopg://crypto:change-me@postgres:5432/crypto_intelligence
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
BINANCE_SPOT_BASE_URL=https://api.binance.com
# Where api.binance.com is restricted by location, use the public
# market-data endpoint instead: https://data-api.binance.vision
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_REQUEST_TIMEOUT_SECONDS=10
BINANCE_MAX_RETRIES=3
TRACKED_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT
# Phase 6 competition volume tracker
VOLUME_TRACKING_INTERVAL_MINUTES=30
VOLUME_BACKFILL_MAX_INTERVALS_PER_PAIR=48
VOLUME_MAX_PAGES_PER_INTERVAL=50
VOLUME_NOTIFICATIONS_ENABLED=true
